# Build output
/bin/
/dist/
*.exe
*.test
*.out

# Coverage
coverage
coverage.out
coverage.html

# Go
vendor/

# Local state that must never be committed
.termixgo/
# The pre-rename state directory. The code stopped writing here when the
# project became Termixgo, but a tree that still has one must not commit it.
.termigo/
secrets.json

# Local tool caches
.gocache/

# A stray Node dependency tree is never part of this Go module.
node_modules/

# A downloaded Go toolchain, its tarball and a manual root-level cross-build
# are never part of this module. The project builds from the installed Go.
/go/
go.tar.gz
/termixgo-linux

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
